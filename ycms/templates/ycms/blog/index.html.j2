{% extends "ycms/blog/base.html" %}

{% block title %}Blog{% endblock %}

{% block header %}<h1>Blog Posts</h1>{% endblock %}

    {% block blog_content %}
        {% for post in posts %}
            <article class="post">
                <header> 
                <h1><a href="{{ url_for('blog.post', slug=post['slug']) }}">{{ post['title'] }}</a></h1>
                <div class="about">
                    by {{ post['username'] }} on {{ post['published_at'].strftime('%Y-%m-%d') }}
                </div>
                </header>
                <p class="body ycms-math">{{ post | post_preview }}</p>
                <a href="{{ url_for('blog.post', slug=post['slug']) }}">Read more →</a>
            </article>
            {% if not loop.last %}<hr>{% endif %}
            {% else %}
                <p>No posts yet.</p>
        {% endfor %}

    <nav class="pagination">

    {# prev — render only when one exists #}
    {% if page > 1 %}
        <a href="{{ url_for('blog.index', page=page-1) }}">&laquo;</a>
    {% endif %}

    {% for n in range(1, total_pages + 1) %}
        {% if n == page %}
            <span class="current">{{ n }}</span>
        {% else %}
            <a href="{{url_for('blog.index', page=n)}}">{{ n }}</a>
        {% endif %}
    {% endfor %}

    {# next — same condition, other end #}
    {% if page < total_pages %}
        <a href="{{ url_for('blog.index', page=page+1) }}">&raquo;</a>
    {% endif %}
    </nav>
{% endblock %}